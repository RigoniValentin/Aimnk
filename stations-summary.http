@API_BASE_URL = http://localhost:3010/api/v1
@TOKEN = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..l76PgoK36Q5lStoSRgWcZrna-GvGz0eHsaCTUWl-bQI

### Resumen de todas las estaciones del usuario autenticado
GET {{API_BASE_URL}}/stations/summary
Authorization: Bearer {{TOKEN}}
Accept: application/json

### Ejemplo de respuesta esperada (200 OK)
# {
#   "userId": "6655a0...",
#   "stations": {
#     "verdad": { "data": { /* ... */ } | null, "updatedAt": "2025-08-15T12:34:56.000Z" | null },
#     "pilares": { "data": { /* ... */ } | null, "updatedAt": "..." },
#     "codinconciente": { "data": { /* ... */ } | null, "updatedAt": "..." },
#     "tarot": { "data": { /* ... */ } | null, "updatedAt": "..." },
#     "humanoreal": { "data": { /* ... */ } | null, "updatedAt": "..." },
#     "artebiologico": { "data": { /* ... */ } | null, "updatedAt": "..." },
#     "arteemociones": { "data": { /* ... */ } | null, "updatedAt": "..." },
#     "arteconsciencia": { "data": { /* ... */ } | null, "updatedAt": "..." },
#     "arteenergia": { "data": { /* ... */ } | null, "updatedAt": "..." }
#   },
#   "generatedAt": "2025-08-15T12:34:56.000Z"
# }

### Caso 401 (sin token o inválido)
# GET {{API_BASE_URL}}/stations/summary
# Accept: application/json
